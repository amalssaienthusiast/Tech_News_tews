# Production Environment Configuration Template
# Copy to .env in production deployment

TECHNEWS_ENV=production
TECHNEWS_DB_PATH=/data/canonical_technews.db
TECHNEWS_LOG_LEVEL=INFO
TECHNEWS_ENABLE_PROMETHEUS=true
TECHNEWS_PORT=8000

# RBAC API Keys (Ensure to replace with cryptographically secure random tokens)
TECHNEWS_ADMIN_API_KEY=prod_admin_secret_key_random_hex_64
TECHNEWS_RW_API_KEY=prod_rw_secret_key_random_hex_64
TECHNEWS_RO_API_KEY=prod_ro_secret_key_random_hex_64

# Rate Limiting & Queue Limits
TECHNEWS_BURST_CAPACITY=100
TECHNEWS_REFILL_RATE_PER_SEC=10.0
TECHNEWS_MAX_REQUEST_SIZE_BYTES=2097152
